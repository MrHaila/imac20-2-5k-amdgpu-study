From ac8bcdcad7cb70c681002f07a767a184b8e9fbd3 Mon Sep 17 00:00:00 2001
From: Teemu Haila <teemu.haila@gmail.com>
Date: Sat, 10 Oct 2026 20:56:58 +0300
Subject: [PATCH 26/31] drm/amd/display: per-frame tile reset from the master
 OTG on DCN (A5)

With amdgpu.tiled_genlock=1 the iMac20 tile pair uses DC's per-frame OTG
reset. On DCN, enable_timing_multisync() hands
dcn10_enable_per_frame_crtc_position_reset() the slave pipes only, and that
arms each of them on OTG 0's vsync. That is right only if the master
stream happens to sit on OTG 0. The stitch adds the peer stream before the
root, so it probably gets OTG 0 and is picked as master, which would make
this work by coincidence. A different pipe assignment would lock the slave
to an unrelated OTG, or to itself.

Behind a new dc->config.apple_tiled_genlock flag, set only on a DMI-matched
iMac20 with tiled_genlock=1: put the master pipe first (as Pronkin's
dce12-multisync-master-first already does for DCE 12), take the trigger
source from its OTG, and arm and wait on the slaves only. Other DCN users
see no change.

Not done here: tearing the trigger down when the pair is disabled
(DESIGN.md A6). Until then an OTG that later drives another display could
keep resetting on the old master's vsync, so tiled_genlock=1 is for test
boots only.

[adapter: new, Sysadmin patches/amdgpu-imac20-2-5k-stitch DESIGN.md A5]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SUvgXxxT5Apr7YLjKZVd2T
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c |  2 ++
 drivers/gpu/drm/amd/display/dc/core/dc.c      |  7 ++++++-
 drivers/gpu/drm/amd/display/dc/dc.h           |  5 +++++
 .../amd/display/dc/hwss/dcn10/dcn10_hwseq.c   | 21 ++++++++++++++-----
 4 files changed, 29 insertions(+), 6 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index f41777868..2888357aa 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -3065,6 +3065,8 @@ static int amdgpu_dm_init(struct amdgpu_device *adev)
 		init_data.flags.support_edp0_on_dp1 = true;
 	if (adev->dm.apple_imac20_tiles_quirk)
 		init_data.flags.apple_imac20_tiles = true;
+	if (adev->dm.apple_imac20_tiles_quirk && amdgpu_tiled_genlock == 1)
+		init_data.flags.apple_tiled_genlock = true;
 
 	if (adev->dm.bb_from_dmub)
 		init_data.bb_from_dmub = adev->dm.bb_from_dmub;
diff --git a/drivers/gpu/drm/amd/display/dc/core/dc.c b/drivers/gpu/drm/amd/display/dc/core/dc.c
index 6939a60c6..c561012f1 100644
--- a/drivers/gpu/drm/amd/display/dc/core/dc.c
+++ b/drivers/gpu/drm/amd/display/dc/core/dc.c
@@ -1624,8 +1624,13 @@ static void enable_timing_multisync(
 	 * slaves, GSL group 0 gets no master and the armed slaves wait on a
 	 * trigger nothing generates ("GSL: Timeout on reset trigger!"). Other
 	 * generations keep the slaves-only list: DCN arms every entry from 0.
+	 *
+	 * Apple 5K tile pair on DCN (iMac20,x): also master first, so that
+	 * dcn10_enable_per_frame_crtc_position_reset() can take the trigger
+	 * source from it instead of assuming the master sits on OTG 0.
 	 */
-	bool master_first = dc->ctx->dce_version == DCE_VERSION_12_0;
+	bool master_first = dc->ctx->dce_version == DCE_VERSION_12_0 ||
+			    dc->config.apple_tiled_genlock;
 
 	if (master_first) {
 		for (i = 0; i < pipe_count; i++) {
diff --git a/drivers/gpu/drm/amd/display/dc/dc.h b/drivers/gpu/drm/amd/display/dc/dc.h
index 826ca6f20..15da978a7 100644
--- a/drivers/gpu/drm/amd/display/dc/dc.h
+++ b/drivers/gpu/drm/amd/display/dc/dc.h
@@ -613,6 +613,11 @@ struct dc_config {
 	 * only when this is set (dc_apple_tiles_allowed()).
 	 */
 	bool apple_imac20_tiles;
+	/*
+	 * Per-frame OTG reset for the Apple tile pair on DCN: the master pipe
+	 * comes first and is the trigger source (see enable_timing_multisync()).
+	 */
+	bool apple_tiled_genlock;
 	unsigned int enable_fpo_flicker_detection;
 	bool disable_hbr_audio_dp2;
 	bool consolidated_dpia_dp_lt;
diff --git a/drivers/gpu/drm/amd/display/dc/hwss/dcn10/dcn10_hwseq.c b/drivers/gpu/drm/amd/display/dc/hwss/dcn10/dcn10_hwseq.c
index 7112b71af..0575608eb 100644
--- a/drivers/gpu/drm/amd/display/dc/hwss/dcn10/dcn10_hwseq.c
+++ b/drivers/gpu/drm/amd/display/dc/hwss/dcn10/dcn10_hwseq.c
@@ -2670,21 +2670,32 @@ void dcn10_enable_per_frame_crtc_position_reset(
 	int group_size,
 	struct pipe_ctx *grouped_pipes[])
 {
-	int i;
+	int i, first = 0, source_tg_inst = 0;
 
 	DC_LOGGER_INIT(dc->ctx);
 
-	DC_SYNC_INFO("Setting up\n");
-	for (i = 0; i < group_size; i++)
+	/*
+	 * Stock callers pass slaves only, and every one is armed on OTG 0's
+	 * vsync: right only when the master happens to sit on OTG 0. For the
+	 * Apple tile pair enable_timing_multisync() puts the master in slot 0,
+	 * so lock the slaves to its OTG and never arm the master on itself.
+	 */
+	if (dc->config.apple_tiled_genlock && group_size > 1) {
+		source_tg_inst = grouped_pipes[0]->stream_res.tg->inst;
+		first = 1;
+	}
+
+	DC_SYNC_INFO("Setting up, source OTG%d\n", source_tg_inst);
+	for (i = first; i < group_size; i++)
 		if (grouped_pipes[i]->stream_res.tg->funcs->enable_crtc_reset)
 			grouped_pipes[i]->stream_res.tg->funcs->enable_crtc_reset(
 					grouped_pipes[i]->stream_res.tg,
-					0,
+					source_tg_inst,
 					&grouped_pipes[i]->stream->triggered_crtc_reset);
 
 	DC_SYNC_INFO("Waiting for trigger\n");
 
-	for (i = 0; i < group_size; i++)
+	for (i = first; i < group_size; i++)
 		wait_for_reset_trigger_to_occur(dc_ctx, grouped_pipes[i]->stream_res.tg);
 
 	DC_SYNC_INFO("Multi-display sync is complete\n");
