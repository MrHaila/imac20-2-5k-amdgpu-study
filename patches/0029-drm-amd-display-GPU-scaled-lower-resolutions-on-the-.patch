 	if (!amdgpu_dm_connector_tiled_stitch_geometry(connector, &tile_w, &tile_h))
 		return false;
 
-	if (mode->hdisplay != 2 * tile_w || mode->vdisplay != tile_h)
+	/*
+	 * The stitched native mode, or one of the GPU-scaled modes added by
+	 * amdgpu_dm_tiled_stitch_add_scaled_modes(): no larger than the panel,
+	 * and an even width, so the source splits exactly at the seam.
+	 */
