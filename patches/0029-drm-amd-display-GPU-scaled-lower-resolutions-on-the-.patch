 		dc_stream_release(stream);
 		result = MODE_OK;
 	} else if (amdgpu_dm_is_tiled_slave(aconnector) &&
@@ -11688,8 +11820,8 @@ static void amdgpu_dm_tiled_peer_cursor_pos(const struct dc_stream_state *peer,
 		const struct dc_cursor_position *root_pos,
 		struct dc_cursor_position *pos)
 {
-	/* The peer stream carries the tile timing (cloned from the root). */
-	int tile_w = peer->timing.h_addressable;
+	/* The peer composes the right half of the CRTC mode (src.width wide). */
+	int tile_w = peer->src.width;
 	int max_cursor = peer->ctx->dc->caps.max_cursor_size;
 	int x = (int)root_pos->x - tile_w;
 
@@ -12077,9 +12209,10 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 		if (acrtc_state->stream_peer && dm_new_plane_state->dc_state_peer &&
 		    plane == pcrtc->primary && new_plane_state->fb &&
