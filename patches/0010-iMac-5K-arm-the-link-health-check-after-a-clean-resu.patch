From fa27c4b6ec1b2e835d0ca381c8751f3eda24680b Mon Sep 17 00:00:00 2001
From: Teemu Haila <teemu.haila@gmail.com>
Date: Sat, 10 Oct 2026 20:45:46 +0300
Subject: [PATCH 10/36] iMac 5K: arm the link-health check after a clean resume

[upstream: imac5k-universal-linux-patcher patches/5k-resume-arm-link-health.patch @ c1086d2b438c]
Applied unchanged with patch -p1 onto v7.2.11-arch1 + probe-defer.

The post-commit link-health check and the tile timing sync are queued by
amdgpu_dm_queue_tiled_resync() at the end of every commit that modesets the
stitched root. It skips commits made while adev->in_suspend is set. The
resume commit is one of them: dm_resume() replays the cached state from
amdgpu_device_ip_resume(), and amdgpu_device_resume() clears in_suspend only
at its end.

Once 5k-resume-drop-cached-peer.patch made the resume commit succeed, no
later modeset followed it, so a resumed panel was never checked or
timing-synced. Before that fix, the failed resume commit forced a post-exit
modeset, and that modeset armed the check.

Seen on iMac18,3, kernel 7.2.3, lean stack + guard + resume-peer, 2026-09-10:
pm_test=devices (deep). The resume commit logged "added peer slave-tile
stream" and no "link-health armed" line followed for the rest of the boot.

When the only reason for the skip is in_suspend, note the tiled modeset.
DM's new .complete hook runs from amdgpu_pmops_complete() after
amdgpu_device_resume() has returned, and arms the check and the sync then.
The PM core calls .complete on every resume transition, including failed
ones. If in_suspend is still set, the queue skips the modeset again and
notes it again, so nothing runs while the device is down.

Applies on top of 5k-post-commit-link-recovery.patch (which adds the
link-health check) and 5k-resume-drop-cached-peer.patch.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SUvgXxxT5Apr7YLjKZVd2T
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 26 +++++++++++++++++++
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h |  2 ++
 2 files changed, 28 insertions(+)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index ddaa66f80..97dbe70f6 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -2797,6 +2797,7 @@ static int amdgpu_dm_init(struct amdgpu_device *adev)
 	adev->dm.tiled_link_checks = 0;
 	adev->dm.tiled_link_recoveries = 0;
 	adev->dm.tiled_sync_pending = false;
+	adev->dm.tiled_resume_modeset = false;
 	drm_info(adev_to_drm(adev),
 		 "APPLE5K: link-health build=post-commit-recovery checks=%u recoveries=%u delay_ms=%u+%u\n",
 		 APPLE5K_LINK_CHECKS, APPLE5K_LINK_RECOVERIES,
@@ -4821,6 +4822,26 @@ static int dm_resume(struct amdgpu_ip_block *ip_block)
  * The functions to do so are provided as hooks in &struct amd_ip_funcs.
  */
 
+/*
+ * The resume commit runs from dm_resume() while adev->in_suspend is still set,
+ * so amdgpu_dm_queue_tiled_resync() only noted its tiled modeset. The PM core
+ * calls .complete after amdgpu_device_resume() has cleared in_suspend: arm the
+ * link-health check and the tile timing sync now.
+ */
+static void dm_complete(struct amdgpu_ip_block *ip_block)
+{
+	struct amdgpu_device *adev = ip_block->adev;
+	bool modeset;
+
+	mutex_lock(&adev->dm.dc_lock);
+	modeset = adev->dm.tiled_resume_modeset;
+	adev->dm.tiled_resume_modeset = false;
+	mutex_unlock(&adev->dm.dc_lock);
+
+	if (modeset)
+		amdgpu_dm_queue_tiled_resync(adev, true);
+}
+
 static const struct amd_ip_funcs amdgpu_dm_funcs = {
 	.name = "dm",
 	.early_init = dm_early_init,
@@ -4832,6 +4853,7 @@ static const struct amd_ip_funcs amdgpu_dm_funcs = {
 	.hw_fini = dm_hw_fini,
 	.suspend = dm_suspend,
 	.resume = dm_resume,
+	.complete = dm_complete,
 	.is_idle = dm_is_idle,
 	.wait_for_idle = dm_wait_for_idle,
 	.check_soft_reset = dm_check_soft_reset,
@@ -15892,6 +15914,10 @@ static void amdgpu_dm_queue_tiled_resync(struct amdgpu_device *adev, bool modese
 		/* Ordinary plane commits must not postpone an already armed check. */
 		queue_delayed_work(system_wq, &adev->dm.tiled_resync_work,
 				   msecs_to_jiffies(APPLE5K_LINK_SETTLE_MS));
+	} else if (modeset && adev->in_suspend && !adev->dm.tiled_resync_stopping &&
+		   !adev->dm.dc->apple_5k_going_down && !amdgpu_in_reset(adev)) {
+		/* The resume commit. dm_complete() arms it once in_suspend clears. */
+		adev->dm.tiled_resume_modeset = true;
 	}
 	mutex_unlock(&adev->dm.dc_lock);
 }
diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
index 94469fb7f..302a2f4d9 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.h
@@ -662,6 +662,8 @@ struct amdgpu_display_manager {
 	u8 tiled_link_recoveries;
 	bool tiled_sync_pending;
 	bool tiled_resync_stopping;
+	/* A tiled modeset ran while in_suspend was set; dm_complete() arms it. */
+	bool tiled_resume_modeset;
 	bool disable_hpd_irq;
 	bool dmcub_trace_event_en;
 	/**
