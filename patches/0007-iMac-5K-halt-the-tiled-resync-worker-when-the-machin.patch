From 9df8518dfd65b64cc991e32caf617379ca9e494b Mon Sep 17 00:00:00 2001
From: Teemu Haila <teemu.haila@gmail.com>
Date: Sat, 10 Oct 2026 20:45:46 +0300
Subject: [PATCH 07/31] iMac 5K: halt the tiled resync worker when the machine
 is going down

[upstream: imac5k-universal-linux-patcher patches/5k-going-down-stop-resync.patch @ c1086d2b438c]
Applied unchanged with patch -p1 onto v7.2.9-arch1 + probe-defer.

Companion to 5k-post-commit-link-recovery.patch, as a separate patch because
amdgpu_dm_apple5k_going_down() sits at a different file position in the lean
core and the verbose stack, and GNU patch locates hunks in file order -- one
patch cannot carry this hunk for both stacks.

Set the worker's stopping flag and cancel it at the same point where the
going-down gate is raised, so a pending link-health pass cannot fire while
the display is being torn down for firmware.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01SUvgXxxT5Apr7YLjKZVd2T
---
 drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 79b58902f..04155c391 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -2736,8 +2736,13 @@ bool amdgpu_dm_has_apple_tiled_panel(struct amdgpu_device *adev)
 /* From here on the tile wake paths are no-ops; see dc.apple_5k_going_down. */
 void amdgpu_dm_apple5k_going_down(struct amdgpu_device *adev)
 {
-	if (adev && adev->dm.dc)
+	if (adev && adev->dm.dc) {
+		mutex_lock(&adev->dm.dc_lock);
+		adev->dm.tiled_resync_stopping = true;
 		adev->dm.dc->apple_5k_going_down = true;
+		mutex_unlock(&adev->dm.dc_lock);
+		cancel_delayed_work_sync(&adev->dm.tiled_resync_work);
+	}
 }
 
 /* Root eDP panel off, held for T12: the firmware finds it as a cold boot does. */
