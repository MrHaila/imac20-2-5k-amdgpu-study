From 5d7b92a4676db6dfe341212da470499167f54477 Mon Sep 17 00:00:00 2001
From: Teemu Haila <teemu.haila@gmail.com>
Date: Sun, 11 Oct 2026 18:40:58 +0300
Subject: [PATCH 29/31] drm/amd/display: add the tiled root stream before the
 peer (L7)

dm_update_crtc_state() added the peer (right-tile) stream to the DC context
before the root. Pipes are acquired in stream order and enabled in ascending
pipe order, so on a cold pipe pool (every DPMS-on) link 1 trained before link 0
had powered the panel and pulsed the 0x4F1 tile latch: "DP link(1) sink AUX not
ready for training", "enabling link 1 failed: 15", and the TCON scaled the root
tile over the whole panel until link-health retrained link 1 (~1 s; 5 of 5
wakes in run 041). Add the root first.

[adapter: iMac20 PoC, REVIEW.md L7]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 26 +++++++++++++------
 1 file changed, 18 insertions(+), 8 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 40cff2993..80bd6343f 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -14080,6 +14080,24 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 						 new_stream->link->link_index);
 			}
 
+			/*
+			 * iMac20 L7 fix: add the root stream BEFORE the peer.
+			 * Pipes are acquired in stream order and enabled in
+			 * ascending pipe order, so with the peer first link 1
+			 * trained before link 0 had powered the panel and pulsed
+			 * the 0x4F1 tile latch: on every DPMS-on the slave AUX was
+			 * dead ("sink AUX not ready", "enabling link 1 failed")
+			 * and the TCON showed the root tile scaled over the whole
+			 * panel until link-health retrained link 1 (~1 s, run 041).
+			 */
+			if (dc_state_add_stream(
+					dm->dc,
+					dm_state->context,
+					dm_new_crtc_state->stream) != DC_OK) {
+				ret = -EINVAL;
+				goto fail;
+			}
+
 			/*
 			 * Tiled stitch: drive the slave (right) tile from this
 			 * SAME root crtc as a peer stream, so one connector
@@ -14131,14 +14149,6 @@ static int dm_update_crtc_state(struct amdgpu_display_manager *dm,
 				}
 			}
 
-			if (dc_state_add_stream(
-					dm->dc,
-					dm_state->context,
-					dm_new_crtc_state->stream) != DC_OK) {
-				ret = -EINVAL;
-				goto fail;
-			}
-
 			*lock_and_validation_needed = true;
 		}
 	}
