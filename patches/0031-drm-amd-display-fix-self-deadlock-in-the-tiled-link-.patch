From 946b56828ba55b7756552cb4f92462a94556ece4 Mon Sep 17 00:00:00 2001
From: Teemu Haila <teemu.haila@gmail.com>
Date: Sun, 11 Oct 2026 20:00:40 +0300
Subject: [PATCH 31/31] drm/amd/display: fix self-deadlock in the tiled
 link-status escalation

amdgpu_dm_tiled_request_full_modeset() took mode_config.connection_mutex
and then called drm_connector_set_link_status_property(), which takes the
same lock itself (since v4.12). The resync worker deadlocked on its own
lock the first time link-health escalated, and every later modeset, fbcon
unblank and connector probe queued behind it until the hung-task detector
fired (dev run 057: link-health FAIL at boot, hung tasks after 122 s).
Drop the outer lock.

[fix: reused stack (Pronkin link-health escalation), found on iMac20 dev run 057]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 3 +--
 1 file changed, 1 insertion(+), 2 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index c68fd761d..f2f6ed330 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -16348,10 +16348,9 @@ static void amdgpu_dm_tiled_request_full_modeset(struct amdgpu_device *adev)
 		root->dc_link->tiled_peer->link_state_valid = false;
 	mutex_unlock(&adev->dm.dc_lock);
 
-	drm_modeset_lock(&dev->mode_config.connection_mutex, NULL);
+	/* Takes connection_mutex itself: locking it here too self-deadlocks. */
 	drm_connector_set_link_status_property(&root->base,
 					       DRM_MODE_LINK_STATUS_BAD);
-	drm_modeset_unlock(&dev->mode_config.connection_mutex);
 	drm_kms_helper_connector_hotplug_event(&root->base);
 	drm_info(dev,
 		 "APPLE5K: reported link status BAD on %s to force a full modeset (%u/%u this minute)\n",
-- 
2.55.0

