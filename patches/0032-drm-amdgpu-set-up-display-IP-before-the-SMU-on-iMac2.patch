From bc915cd72e9e91ff3932afe504836d176107ec99 Mon Sep 17 00:00:00 2001
From: t2linux <t2linux@users.noreply.github.com>
Date: Mon, 12 Oct 2026 20:18:43 +0300
Subject: [PATCH 32/33] drm/amdgpu: set up display IP before the SMU on
 iMac20,x (t2linux 7003)

The amdgpu_discovery.c hunk of t2linux 7003-amdgpu-add-support-for-5K.patch
(Atharva Tiwari, linux-t2-patches 65fdd4d), taken alone, with the missing
{ } terminator added to imac5k_table (t2linux/kernel#33).

On iMac20,x Apple EFI leaves the display core in a state that makes the
SMU time out at EnableAllSmuFeatures when the SMU is initialised first.
Adding the display IP blocks before the SMU ones avoids it. Measured on an
iMac20,2 (Navi 10, 1002:731B), linux-t2 7.2.9, warm reboots: 100/100 first
probes OK with this hunk on a vanilla module, against 11/20 without it.
---
 drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c | 31 +++++++++++++++++--
 1 file changed, 28 insertions(+), 3 deletions(-)

diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
index 47e0680ed..a8a148ddf 100644
--- a/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_discovery.c
@@ -21,6 +21,7 @@
  *
  */
 
+#include <linux/dmi.h>
 #include <linux/firmware.h>
 
 #include "amdgpu.h"
@@ -2838,6 +2839,22 @@ static int amdgpu_discovery_set_isp_ip_blocks(struct amdgpu_device *adev)
 	return 0;
 }
 
+static const struct dmi_system_id imac5k_table[] = {
+	{
+		.matches = {
+			 DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			 DMI_MATCH(DMI_PRODUCT_NAME, "iMac20,1"),
+		},
+	},
+	{
+		.matches = {
+			DMI_MATCH(DMI_SYS_VENDOR, "Apple Inc."),
+			DMI_MATCH(DMI_PRODUCT_NAME, "iMac20,2"),
+		},
+	},
+	{ }
+};
+
 int amdgpu_discovery_set_ip_blocks(struct amdgpu_device *adev)
 {
 	int r;
@@ -3435,15 +3452,23 @@ int amdgpu_discovery_set_ip_blocks(struct amdgpu_device *adev)
 		}
 	}
 
+	if (dmi_check_system(imac5k_table)) {
+		r = amdgpu_discovery_set_display_ip_blocks(adev);
+		if (r)
+			return r;
+	}
+
 	if (likely(adev->firmware.load_type == AMDGPU_FW_LOAD_PSP)) {
 		r = amdgpu_discovery_set_smu_ip_blocks(adev);
 		if (r)
 			return r;
 	}
 
-	r = amdgpu_discovery_set_display_ip_blocks(adev);
-	if (r)
-		return r;
+	if (!dmi_check_system(imac5k_table)) {
+		r = amdgpu_discovery_set_display_ip_blocks(adev);
+		if (r)
+			return r;
+	}
 
 	r = amdgpu_discovery_set_gc_ip_blocks(adev);
 	if (r)
-- 
