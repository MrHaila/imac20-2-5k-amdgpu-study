From 71062cf4688e28785e17173718efbecf92c5f86d Mon Sep 17 00:00:00 2001
From: Teemu Haila <teemu.haila@gmail.com>
Date: Sun, 11 Oct 2026 16:36:37 +0300
Subject: [PATCH 27/36] drm/amd/display: stage the tiled peer cursor instead of
 programming it unlocked (B2)

amdgpu_dm_update_cursor() runs from the amdgpu_dm_commit_planes() plane loop on
every DCN part (DCE_HWIP != 0), outside dc_lock. The stitch layer programmed the
peer (right-tile) cursor there directly via dc_stream_program_cursor_*(), which
walks dc->current_state without the lock and lands a frame apart from the root's
staged cursor. DCE parts never take this path, so it was untested.

Stage the peer cursor on the peer stream (dc_stream_set_cursor_*) into the peer's
dc_stream_update, which DC programs under dc_lock with the peer's surface update.
If a commit stages a peer cursor without a peer surface update, program it at the
peer-submit point, where dc_lock is held (a zero-surface update would strip the
peer plane). The callers that already hold dc_lock keep programming directly.

[adapter: iMac20 PoC, REVIEW.md B2]

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c | 112 +++++++++++++-----
 1 file changed, 82 insertions(+), 30 deletions(-)

diff --git a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
index 5da252564..909072763 100644
--- a/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
+++ b/drivers/gpu/drm/amd/display/amdgpu_dm/amdgpu_dm.c
@@ -11684,14 +11684,35 @@ static inline uint32_t get_mem_type(struct drm_framebuffer *fb)
  * clips the seam). No-op when @peer is NULL (every non-stitched crtc), so
  * callers can pass dm_crtc_state->stream_peer unconditionally.
  */
+static void amdgpu_dm_tiled_peer_cursor_pos(const struct dc_stream_state *peer,
+		const struct dc_cursor_position *root_pos,
+		struct dc_cursor_position *pos)
+{
+	/* The peer stream carries the tile timing (cloned from the root). */
+	int tile_w = peer->timing.h_addressable;
+	int max_cursor = peer->ctx->dc->caps.max_cursor_size;
+	int x = (int)root_pos->x - tile_w;
+
+	*pos = *root_pos;
+	if (!root_pos->enable || x <= -max_cursor) {
+		/* cursor entirely in the left tile -> nothing on the peer */
+		pos->enable = false;
+		pos->x = 0;
+	} else if (x < 0) {
+		/* straddling the tile seam: clip the left part via the hotspot */
+		pos->x = 0;
+		pos->x_hotspot = root_pos->x_hotspot + (uint32_t)(-x);
+	} else {
+		pos->x = (uint32_t)x;
+	}
+}
+
+/* Programs the hardware now: callers must hold dm->dc_lock. */
 void amdgpu_dm_tiled_program_peer_cursor(struct dc_stream_state *peer,
 		struct dc_cursor_attributes *attrs,
 		const struct dc_cursor_position *root_pos)
 {
-	struct dc_cursor_position pos = *root_pos;
-	int tile_w;
-	int max_cursor;
-	int x;
+	struct dc_cursor_position pos;
 
 	if (!peer)
 		return;
@@ -11699,29 +11720,40 @@ void amdgpu_dm_tiled_program_peer_cursor(struct dc_stream_state *peer,
 	if (attrs)
 		dc_stream_program_cursor_attributes(peer, attrs);
 
-	/* The peer stream carries the tile timing (cloned from the root). */
-	tile_w = peer->timing.h_addressable;
-	max_cursor = peer->ctx->dc->caps.max_cursor_size;
-
-	x = (int)root_pos->x - tile_w;
-	if (!root_pos->enable || x <= -max_cursor) {
-		/* cursor entirely in the left tile -> nothing on the peer */
-		pos.enable = false;
-		pos.x = 0;
-	} else if (x < 0) {
-		/* straddling the tile seam: clip the left part via the hotspot */
-		pos.x = 0;
-		pos.x_hotspot = root_pos->x_hotspot + (uint32_t)(-x);
-	} else {
-		pos.x = (uint32_t)x;
-	}
-
+	amdgpu_dm_tiled_peer_cursor_pos(peer, root_pos, &pos);
 	dc_stream_program_cursor_position(peer, &pos);
 }
 
+/*
+ * iMac20 B2 fix: the commit path must not program the peer cursor directly.
+ * It runs from the plane loop, before and outside dc_lock, against a
+ * dc->current_state that a concurrent commit can replace. Instead stage it on
+ * the peer stream, the way the root cursor is staged, and let DC program it
+ * with the peer's own stream update under dc_lock (see the peer submit in
+ * amdgpu_dm_commit_planes()).
+ */
+static void amdgpu_dm_tiled_stage_peer_cursor(struct dc_stream_state *peer,
+		struct dc_cursor_attributes *attrs,
+		const struct dc_cursor_position *root_pos,
+		struct dc_stream_update *peer_update)
+{
+	struct dc_cursor_position pos;
+
+	if (!peer)
+		return;
+
+	if (attrs && dc_stream_set_cursor_attributes(peer, attrs))
+		peer_update->cursor_attributes = &peer->cursor_attributes;
+
+	amdgpu_dm_tiled_peer_cursor_pos(peer, root_pos, &pos);
+	if (dc_stream_set_cursor_position(peer, &pos))
+		peer_update->cursor_position = &peer->cursor_position;
+}
+
 static void amdgpu_dm_update_cursor(struct drm_plane *plane,
 				    struct drm_plane_state *old_plane_state,
-				    struct dc_stream_update *update)
+				    struct dc_stream_update *update,
+				    struct dc_stream_update *peer_update)
 {
 	struct amdgpu_device *adev = drm_to_adev(plane->dev);
 	struct amdgpu_framebuffer *afb = to_amdgpu_framebuffer(plane->state->fb);
@@ -11750,8 +11782,8 @@ static void amdgpu_dm_update_cursor(struct drm_plane *plane,
 			dc_stream_set_cursor_position(crtc_state->stream,
 						      &position);
 			update->cursor_position = &crtc_state->stream->cursor_position;
-			amdgpu_dm_tiled_program_peer_cursor(crtc_state->stream_peer,
-							      NULL, &position);
+			amdgpu_dm_tiled_stage_peer_cursor(crtc_state->stream_peer,
+							    NULL, &position, peer_update);
 		}
 		return;
 	}
@@ -11792,8 +11824,8 @@ static void amdgpu_dm_update_cursor(struct drm_plane *plane,
 		update->cursor_position = &crtc_state->stream->cursor_position;
 
 		/* apple5k: also light the cursor on the right-tile peer stream. */
-		amdgpu_dm_tiled_program_peer_cursor(crtc_state->stream_peer,
-						      &attributes, &position);
+		amdgpu_dm_tiled_stage_peer_cursor(crtc_state->stream_peer,
+						    &attributes, &position, peer_update);
 	}
 }
 
@@ -11937,6 +11969,9 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 		goto cleanup;
 	}
 
+	/* Peer (right-tile) stream update; peer cursor changes are staged here. */
+	struct dc_stream_update tiled_peer_stream_update = {0};
+
 	/*
 	 * Disable the cursor first if we're disabling all the planes.
 	 * It'll remain on the screen after the planes are re-enabled
@@ -11957,8 +11992,9 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 				&acrtc_state->stream->cursor_position;
 
 		/* apple5k: disable the native peer cursor too on this transition. */
-		amdgpu_dm_tiled_program_peer_cursor(acrtc_state->stream_peer,
-						      NULL, &cursor_position);
+		amdgpu_dm_tiled_stage_peer_cursor(acrtc_state->stream_peer,
+						    NULL, &cursor_position,
+						    &tiled_peer_stream_update);
 	}
 
 	if (acrtc_state->active_planes == 0 &&
@@ -11970,11 +12006,11 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 	 * as the root plane but with a right-half viewport, and submitted to
 	 * the peer stream after the root submit (same dc_lock, same frame).
 	 * Captured during the plane loop for the primary plane.
+	 * (tiled_peer_stream_update is declared above: cursor staging uses it.)
 	 */
 	struct dc_plane_state *tiled_peer_plane = NULL;
 	struct dc_scaling_info tiled_peer_scaling = {0};
 	struct dc_surface_update tiled_peer_su = {0};
-	struct dc_stream_update tiled_peer_stream_update = {0};
 	int tiled_peer_idx = 0;
 	bool tiled_peer_flip = false;
 
@@ -11995,7 +12031,8 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 			    (old_plane_state->fb && old_plane_state->crtc == pcrtc)) {
 				cursor_update = true;
 				if (amdgpu_ip_version(dm->adev, DCE_HWIP, 0) != 0)
-					amdgpu_dm_update_cursor(plane, old_plane_state, &bundle->stream_update);
+					amdgpu_dm_update_cursor(plane, old_plane_state, &bundle->stream_update,
+								&tiled_peer_stream_update);
 			}
 
 			continue;
@@ -12339,6 +12376,21 @@ static void amdgpu_dm_commit_planes(struct drm_atomic_commit *state,
 						 acrtc_state->stream_peer,
 						 &tiled_peer_stream_update,
 						 &tiled_peer_su);
+		} else if (acrtc_state->stream_peer &&
+			   (tiled_peer_stream_update.cursor_attributes ||
+			    tiled_peer_stream_update.cursor_position)) {
+			/*
+			 * Cursor staged but no peer surface update this commit
+			 * (an update with zero surfaces would strip the peer's
+			 * plane). Program the staged peer cursor now; dc_lock is
+			 * held here.
+			 */
+			struct dc_stream_state *peer = acrtc_state->stream_peer;
+
+			if (tiled_peer_stream_update.cursor_attributes)
+				dc_stream_program_cursor_attributes(peer, &peer->cursor_attributes);
+			if (tiled_peer_stream_update.cursor_position)
+				dc_stream_program_cursor_position(peer, &peer->cursor_position);
 		}
 		updated_planes_and_streams = true;
 
